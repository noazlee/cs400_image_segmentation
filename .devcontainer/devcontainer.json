// The original devcontainer template was generated by AI
{
  "name": "WINN Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "PYTHON_VERSION": "3.12"
    }
  },

  // More shared memory for PyTorch DataLoader workers
  "runArgs": ["--ipc=host"],
  "remoteUser": "nlee",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}